{
  "title": "Aegis",
  "uid": "aegis-svm-v1",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Transactions/sec by verdict",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(aegis_transactions_total[30s])",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inspection latency p50/p95/p99 (µs)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(aegis_inspection_duration_microseconds_bucket[30s]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(aegis_inspection_duration_microseconds_bucket[30s]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(aegis_inspection_duration_microseconds_bucket[30s]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Blocklist size",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "aegis_blocklist_size", "legendFormat": "entries" }
      ]
    },
    {
      "id": 4,
      "title": "Downstream up",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "aegis_downstream_up", "legendFormat": "" }
      ],
      "options": { "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Blocked by rule",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "rate(aegis_transactions_blocked_total[30s])",
          "legendFormat": "{{rule_id}}"
        }
      ]
    }
  ]
}
